# Copy to .env and fill in. .env is gitignored.

# --- Hetzner Cloud ---
# Scope this token to a DEDICATED Hetzner project (see README threat model).
# A token that can delete your other servers is the real "Claude goes crazy" risk.
HCLOUD_TOKEN=

# --- Server shape (all optional; defaults shown) ---
BOX_NAME=hetzner-isolated-vm
BOX_TYPE=cx23            # 2 vCPU / 4 GB, ~EUR6.53/mo (cx22 retired)
BOX_IMAGE=ubuntu-24.04
BOX_LOCATION=nbg1        # nbg1 | fsn1 | hel1 | ash | hil

# --- Access ---
BOX_USER=claude
# Dedicated keypair for this VM (created by us).
BOX_SSH_PUBKEY_FILE=~/.ssh/hetzner-isolated-vm.pub
BOX_SSH_KEY=~/.ssh/hetzner-isolated-vm          # private key used by ansible/ssh
BOX_SSH_PORT=22

# Inbound firewall is auto-locked to your CURRENT public IP (detected at create/
# configure/allow-ip time). No need to hardcode it. If your IP changes and you
# get locked out, run: make allow-ip

# VNC console break-glass password (optional; needs python passlib to hash).
# Lets you log in via Hetzner web console if you ever lock yourself out.
BOX_CONSOLE_PASSWORD=

# --- Claude runtime (optional; not committed) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
