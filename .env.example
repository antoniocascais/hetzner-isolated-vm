# Copy to .env and fill in. .env is gitignored.

# --- Hetzner Cloud ---
# Scope this token to a DEDICATED Hetzner project (see README threat model).
# A token that can delete your other servers is the real "Claude goes crazy" risk.
HCLOUD_TOKEN=

# --- Server shape (all optional; defaults shown) ---
BOX_NAME=hetzner-isolated-vm
BOX_TYPE=cx23            # 2 vCPU / 4 GB, ~EUR6.53/mo (cx22 retired)
BOX_IMAGE=ubuntu-26.04
BOX_LOCATION=nbg1        # nbg1 | fsn1 | hel1 | ash | hil

# --- Access ---
BOX_USER=claude
# Dedicated keypair for this VM (created by us).
BOX_SSH_PUBKEY_FILE=~/.ssh/hetzner-isolated-vm.pub
BOX_SSH_KEY=~/.ssh/hetzner-isolated-vm          # private key used by ansible/ssh
BOX_SSH_PORT=9427

# --- Persistent data volume (all optional; defaults shown) ---
# Survives `make destroy` — deliberately NOT tied to BOX_NAME, so renaming/
# recreating the box can never orphan (and silently keep billing) the old
# volume. Only override VOLUME_NAME if you intend to point at a different
# volume than the one already in use.
VOLUME_NAME=hetzner-isolated-vm-data
VOLUME_SIZE=10           # GB; mounted ext4 at ~/data on the box

# DANGER — leave unset/false. Because VOLUME_NAME is fixed while BOX_NAME is
# not, pointing a second box (blue/green, a typo'd BOX_NAME) at the same
# volume name would make `make create` try to attach it here too. Hetzner's
# own Terraform provider detaches before attaching when a volume's server
# changes, and its Go client defines ErrorCodeVolumeAlreadyAttached --
# evidence (inferred from official-client source, not a confirmed server-
# side contract) that a bare attach like this most likely gets REJECTED
# outright rather than silently moving the volume. "Most likely" isn't
# "certainly", though, and if it's wrong while the other box is running with
# the volume mounted, that's a live filesystem pulled out from under it --
# so `make create` refuses to attempt this by default regardless of which
# way the API actually fails. Only set this to `true` for a deliberate
# migration, after confirming the OTHER box is stopped (`make pause`,
# pointed at it), and unset it again afterwards.
VOLUME_ALLOW_REATTACH=false

# DANGER — leave unset/false. If VOLUME_NAME has drifted (typo'd, or changed
# to match a renamed BOX_NAME) `make create` would otherwise silently
# provision a brand-new, EMPTY volume under the new name while your real
# data sits orphaned (and still billing) under the old one — and report
# success. `make create` refuses this by default whenever any other volume
# already carries this tool's management labels. Only set this to `true` if
# you deliberately mean a second/blue-green volume.
VOLUME_ALLOW_NEW=false

# Inbound firewall is auto-locked to your CURRENT public IP (detected at create/
# configure/allow-ip time). No need to hardcode it. If your IP changes and you
# get locked out, run: make allow-ip

# VNC console break-glass password (optional; needs python passlib to hash).
# Lets you log in via Hetzner web console if you ever lock yourself out.
BOX_CONSOLE_PASSWORD=

# --- Claude runtime (optional; not committed) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
