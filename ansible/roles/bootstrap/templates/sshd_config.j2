# Managed by Ansible — hetzner-isolated-vm
# Public SSH is reachable only from your whitelisted IP (Hetzner firewall).
Port {{ box.ssh_port }}
AddressFamily inet
Protocol 2

PermitRootLogin no
PasswordAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes
AuthenticationMethods publickey
KbdInteractiveAuthentication no
UsePAM yes

AllowUsers {{ box.user }}
MaxAuthTries 4
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2

X11Forwarding no
# `local` (not `no`): RUNBOOK.md documents `-L` tunnels as the way to reach a
# service on the box (e.g. `make ssh EXTRA='-L 8080:localhost:8080'`). `no`
# breaks that documented workflow outright. `local` still refuses `-R`/remote
# forwarding, so it's strictly tighter than `yes` — don't "harden" this back
# to `no` without updating the RUNBOOK to match.
AllowTcpForwarding local
GatewayPorts no
PermitTunnel no
LogLevel VERBOSE

# Match production VPS: post-quantum hybrid KEX preferred
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# Required for scp/sftp on modern OpenSSH clients; absent by default upstream.
Subsystem sftp internal-sftp
